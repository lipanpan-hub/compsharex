{
  "name": "@lppx/compsharex",
  "description": "A multi-command developer CLI tool",
  "version": "0.0.0",
  "author": "lppx",
  "bin": {
    "cps": "./bin/run.js"
  },
  "bugs": "https://github.com/lipanpan-hub/compsharex/issues",
  "dependencies": {
    "@earendil-works/pi-tui": "^1.3.0",
    "@inquirer/prompts": "^8.7.3",
    "@oclif/core": "^4",
    "@oclif/plugin-autocomplete": "^4.0.4",
    "@oclif/plugin-help": "^6",
    "@oclif/plugin-not-found": "^4.0.4",
    "@oclif/plugin-version": "^3.0.5",
    "@oclif/plugin-warn-if-update-available": "^4.0.3",
    "@ucloud-sdks/ucloud-sdk-js": "^0.2.55",
    "fuse.js": "^7.5.0",
    "pino": "^10.4.0",
    "pino-mongodb": "^5.0.0",
    "pino-pretty": "^13.2.0",
    "pino-roll": "^4.0.0",
    "prompts": "^2.4.2",
    "ssh2": "^1.17.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^18",
    "@types/prompts": "^2.4.9",
    "@types/ssh2": "^1.15.6",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^11",
    "oclif": "^4",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/lipanpan-hub/compsharex",
  "keywords": [
    "oclif"
  ],
  "license": "BSL",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "cps",
    "dirname": "compsharex",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-warn-if-update-available",
      "@oclif/plugin-autocomplete",
      "@oclif/plugin-not-found",
      "@oclif/plugin-version"
    ],
    "topicSeparator": " ",
    "topics": {
      "config": {
        "description": "管理本地凭证与配置档案"
      },
      "doctor": {
        "description": "检查本地环境与配置健康状况"
      },
      "feedback": {
        "description": "向官方提交使用反馈或缺陷报告"
      },
      "instance": {
        "description": "管理 CompShare GPU 实例",
        "subtopics": {
          "job": {
            "description": "在实例上提交与管理远程任务"
          }
        }
      },
      "bandwidth": {
        "description": "管理共享带宽及绑定的实例"
      },
      "storage": {
        "description": "管理数据盘与 US3 存储挂载"
      },
      "team": {
        "description": "管理团队、成员、邀请与配额"
      },
      "image": {
        "description": "管理镜像的创建、分享与收藏"
      },
      "minimax": {
        "description": "调用 MiniMax 视频、音频与图像服务"
      },
      "llm": {
        "description": "调用优云智算 LLM 服务",
        "subtopics": {
          "indextts": {
            "description": "IndexTTS 语音合成与自定义音色管理"
          }
        }
      }
    },
    "nsisCustomization": "nsis/nsis.nsi",
    "hooks": {
      "init": "./dist/hooks/init/inithook"
    }
  },
  "repository": "lipanpan-hub/compsharex",
  "scripts": {
    "build": "shx rm -rf dist tsconfig.tsbuildinfo oclif.manifest.json && tsc -b && oclif manifest",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md",
    "start": "node ./bin/run.js",
    "pack:tarballs": "oclif pack tarballs",
    "pack:win": "oclif pack win",
    "pack:macos": "oclif pack macos",
    "pack:deb": "oclif pack deb"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "dist/index.d.ts"
}
